// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  FINANCE_OFFICER
  FIELD_OFFICER
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionCategory {
  TRANSPORT
  SUPPLIES
  ALLOWANCE
  ACCOMMODATION
  COMMUNICATION
  OTHER
}

enum AuditAction {
  LOGIN
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  TRANSACTION_CREATED
  TRANSACTION_APPROVED
  TRANSACTION_REJECTED
  USER_CREATED
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(FIELD_OFFICER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  createdProjects     Project[]     @relation("ProjectCreatedBy")
  createdTransactions Transaction[] @relation("TransactionCreatedBy")
  approvedTransactions Transaction[] @relation("TransactionApprovedBy")
  auditLogs           AuditLog[]

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  location    String
  budget      Decimal  @db.Decimal(12, 2)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdById  String
  createdBy    User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  transactions Transaction[]

  @@map("projects")
}

model Transaction {
  id          String              @id @default(cuid())
  amount      Decimal             @db.Decimal(12, 2)
  category    TransactionCategory
  description String
  date        DateTime
  status      TransactionStatus   @default(PENDING)
  receiptUrl  String?
  note        String?             // rejection note from Finance Officer
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  approvedAt  DateTime?

  // Relations
  projectId    String
  project      Project @relation(fields: [projectId], references: [id])

  createdById  String
  createdBy    User    @relation("TransactionCreatedBy", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("TransactionApprovedBy", fields: [approvedById], references: [id])

  @@map("transactions")
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String      // "Transaction" | "Project" | "User"
  entityId   String
  meta       Json?       // additional context (old status, new status, etc.)
  createdAt  DateTime    @default(now())

  // Relations
  userId     String
  user       User        @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
